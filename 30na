    register.add_argument('worker_id')
    register.add_argument('--artifact-id', required=True)
    register.add_argument('--artifact-hash', required=True)
    register.add_argument('--entrypoint', required=True)
    register.add_argument('--configuration', type=json_object, default={})
    register.add_argument('--schedule', choices=('manual','interval'), default='manual')
    register.add_argument('--interval', type=int)
