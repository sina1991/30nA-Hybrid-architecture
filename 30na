    account_commands.add_parser('logout')
    chat = categories.add_parser('chat')
    chat.add_argument('--dashboard-url', default='https://localhost:18446')
    chat.add_argument('--token-file', default=default_session)
    chat.add_argument('--ca-file', default='/etc/30na/ca/trust.pem')
    chat_commands=chat.add_subparsers(dest='action',required=True)
