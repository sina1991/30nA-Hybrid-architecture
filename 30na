class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def json_object(value):
    try:
        if value == "-":
            value = sys.stdin.read(1000001)
            if len(value.encode("utf-8")) > 1000000:
                raise ValueError("input too large")
        obj = json.loads(value)
    except (ValueError, TypeError) as error:
        raise argparse.ArgumentTypeError('Expected a JSON object') from error
    if not isinstance(obj, dict) or any(str(key).startswith('_') for key in obj):
        raise argparse.ArgumentTypeError('Expected a JSON object without reserved fields')
    return obj


def read_token(path):
    path = Path(path)
    mode = path.stat().st_mode
    if not stat.S_ISREG(mode) or stat.S_IMODE(mode) & 0o077:
        raise ValueError('Token file must be a private regular file (0400 or 0600)')
    value = path.read_text(encoding='utf-8').strip()
    if not value or not value.isascii() or any(c.isspace() for c in value):
        raise ValueError('Invalid token file')
    return value


def worker_request(args, method, path, payload=None):
    url = urlsplit(args.manager_url)
    if url.scheme != 'https' or not url.hostname or url.username or url.password or url.query or url.fragment or url.path not in ('', '/'):
        raise ValueError('Manager URL must be an HTTPS origin')
    token = read_token(args.token_file)
    context = ssl.create_default_context(cafile=args.ca_file)
    opener = build_opener(NoRedirect(), HTTPSHandler(context=context))
    data = None if payload is None else json.dumps(payload, allow_nan=False).encode('utf-8')
    if data is not None and len(data) > 1000000:
        raise ValueError('Input too large')
    headers = {'Accept':'application/json', 'Authorization':'Bearer '+token}
    if data is not None:
        headers['Content-Type'] = 'application/json'
    request = Request(args.manager_url.rstrip('/') + path, data=data, headers=headers, method=method)
    try:
        with opener.open(request, timeout=15) as response:
            body = response.read(2000001)
            if len(body) > 2000000:
                raise ValueError('Response too large')
    except HTTPError as error:
        raise ValueError(('Demo' if path.startswith('/api/upstreams/demo/') else 'Manager')+' returned HTTP '+str(error.code)) from None
    except (URLError, TimeoutError, OSError):
        raise ValueError('Manager request did not complete; inspect history before retrying') from None
    result = json.loads(body)
    if not isinstance(result, dict) or not str(result.get('contract_version', '')).startswith('1.') or not isinstance(result.get('payload'), dict):
        raise ValueError('Invalid Manager response')
    return result['payload']


def account_login(args):
    parts = urlsplit(args.dashboard_url)
    if parts.scheme != 'https' or not parts.hostname or parts.username or parts.password or parts.query or parts.fragment or parts.path not in ('', '/'):
        raise ValueError('Dashboard URL must be an HTTPS origin')
    if not sys.stdin.isatty(): raise ValueError('Interactive terminal required for password entry')
    password = getpass.getpass('Password: ')
    context = ssl.create_default_context(cafile=args.ca_file)
    opener = build_opener(NoRedirect(), HTTPSHandler(context=context))
    body = json.dumps({'username':args.username,'password':password}).encode('utf-8')
    request = Request(args.dashboard_url.rstrip('/') + '/api/upstreams/account/login', data=body,
                      headers={'Accept':'application/json','Content-Type':'application/json'}, method='POST')
    try:
        with opener.open(request,timeout=15) as response: payload=json.loads(response.read(100001))['payload']
    except (HTTPError, URLError, TimeoutError, OSError, ValueError, KeyError):
        raise ValueError('Sign-in failed or Dashboard is unavailable') from None
    path = Path(args.token_file).expanduser()
    path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    if path.parent.is_symlink() or path.is_symlink(): raise ValueError('Invalid token file path')
    parent = path.parent.stat()
    if parent.st_uid != os.geteuid() or stat.S_IMODE(parent.st_mode) & 0o077:
        raise ValueError('Token directory must be private and owned by the current user')
    fd, temporary = tempfile.mkstemp(prefix='.30na-session-',dir=path.parent)
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as stream:
            os.fchmod(stream.fileno(),0o600); stream.write(payload['token'] + '\n'); stream.flush(); os.fsync(stream.fileno())
        os.replace(temporary,path)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)
    return {'user':payload['user'], 'expires_at':payload['expires_at'], 'token_file':str(path)}


