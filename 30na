    if len(sys.argv) == 1 and sys.stdin.isatty():
        sys.argv.append('shell')
    args = parser.parse_args()
    try:
        if args.category == 'shell':
            if not sys.stdin.isatty():
                raise ValueError('Interactive mode requires a terminal')
            from terminal_ui import Terminal
            return Terminal(args.owner, args.manager_url, args.token_file, args.ca_file).run()
        if args.category == 'modules':
            if args.action == 'list':
                result = {'modules': list_modules()}
            else:
                if bool(args.owner) != bool(args.slot):
                    raise ValueError('--owner and --slot must be supplied together')
                data = dict(args.input)
                if args.owner and args.module_id not in ('counter','slot-note','chat-box','music-player','media-image','media-audio','media-video','media-player','demo-account','demo-trade','demo-bot','demo-positions','demo-reports','session-windows','session-clock','round-levels','previous-day-levels','previous-day-session-levels'):
                    raise ValueError('Shared state is supported for stateful trusted modules and technical indicators')
                if args.owner:
                    data.update(_state_owner=args.owner, _state_slot=args.slot)
                result = run_module(args.module_id, data)
        elif args.category=='demo':
            from urllib.parse import urlencode
            args.manager_url=args.dashboard_url
            if args.action in ('state','report'):
                query={}
                if args.account_id:query['account_id']=args.account_id
                if args.action=='report':
                    query['since']=args.since
                    if args.until is not None:query['until']=args.until
                result=worker_request(args,'GET','/api/upstreams/demo/'+('reports' if args.action=='report' else 'state')+('?' + urlencode(query) if query else ''))
            elif args.action in ('create','market','bot','from-worker'):
                body=dict(args.input)
                if args.action in ('market','bot'):
                    body.setdefault('request_id',str(uuid4()));print('Request ID: '+str(body['request_id']),file=sys.stderr)
                path={'create':'accounts','market':'trades','bot':'bot','from-worker':'from-execution'}[args.action]
                result=worker_request(args,'POST','/api/upstreams/demo/'+path,body)
            elif args.action in ('select','settings','pin'):
                if not re.fullmatch(r'demo-[0-9a-f]{32}',args.account_id):raise ValueError('Invalid demo account ID')
                body={'settings':args.input} if args.action=='settings' else args.input if args.action=='pin' else {}
                result=worker_request(args,'PUT' if args.action=='settings' else 'POST','/api/upstreams/demo/accounts/'+args.account_id+'/'+args.action,body)
            else:
                if not re.fullmatch(r'trade-[0-9a-f]{32}',args.trade_id):raise ValueError('Invalid trade ID')
                result=worker_request(args,'POST','/api/upstreams/demo/trades/'+args.trade_id+'/'+args.action,{})
        elif args.category == 'account':
            if args.action == 'login': result = account_login(args)
            else:
                args.manager_url=args.dashboard_url
                result=worker_request(args,'POST','/api/upstreams/account/logout',{})
                Path(args.token_file).expanduser().unlink(missing_ok=True)
        elif args.category == 'chat':
            args.manager_url=args.dashboard_url
            if args.action in ('rooms','users','requests'):
                result=worker_request(args,'GET','/api/upstreams/chat/'+args.action)
            elif args.action == 'invite':
                result=worker_request(args,'POST','/api/upstreams/chat/requests',{'recipient':args.recipient})
            elif args.action == 'respond':
                result=worker_request(args,'POST','/api/upstreams/chat/requests/'+quote(args.request_id,safe='')+'/respond',{'accept':args.response == 'accept'})
            elif args.action == 'messages':
                if not 1 <= args.limit <= 200: raise ValueError('Limit must be between 1 and 200')
                result=worker_request(args,'GET','/api/upstreams/chat/rooms/'+quote(args.room,safe='')+'/messages?limit='+str(args.limit))
            else:
                result=worker_request(args,'POST','/api/upstreams/chat/rooms/'+quote(args.room,safe='')+'/messages',{'text':args.text})
        elif args.category == 'indicators':
            if args.action == 'list': result = {'indicators':indicator_profiles.list_profiles(args.owner)}
            else:
                profile = next((item for item in indicator_profiles.list_profiles(args.owner) if item['id'] == args.indicator_id), None)
                if profile is None: raise LookupError('indicator not found')
                data = market_chart(interval=args.interval, limit=args.limit, include_open=not args.closed, profiles=[profile])
                result = {'symbol':data['symbol'], 'interval':data['interval'], **data['series'][0],
                          'last_success':data['last_success'], 'collector_error':data['collector_error']}
        elif args.category == 'signals':
            if args.action == 'list': result = {'rules':signal_rules.list_rules(args.owner)}
            elif args.action == 'input': result = signal_rules.market_input(args.owner, args.interval)
            else: result = signal_rules.evaluate_and_save(args.owner, args.rule_id)
        elif args.category == 'slots':
            if args.action == 'list': result = {'slots':slots.list_slots(args.owner)}
            elif args.action == 'read': result = slots.read(args.owner, args.slot_id)
            elif args.action == 'run': result = slots.execute(args.owner, args.slot_id, args.input, expected_module=args.expect_module)
            elif args.action == 'worker':
                row = next((item for item in slots.list_active(args.owner) if item['slot'] == args.slot_id), None)
                if row is None: raise LookupError('slot is not active')
                existing = row.get('worker')
                if args.worker_action == 'status': result = {'slot': args.slot_id, 'worker': existing}
                else:
                    if args.worker_action == 'stop' and existing is None: raise LookupError('slot worker is not configured')
                    spec = {'enabled': args.worker_action == 'start',
                            'kind': args.kind if args.worker_action == 'start' else existing['kind'],
                            'interval_seconds': args.interval if args.worker_action == 'start' else existing['interval_seconds'],
                            'input': args.input if args.worker_action == 'start' else existing['input']}
                    result = {'slot': args.slot_id, 'worker': slot_workers.configure(args.owner, args.slot_id, spec)}
            else: result = {'slot':args.slot_id, **slots.binding(args.owner, args.slot_id, args.module_id, args.context)}
        elif args.action == 'list':
            result = worker_request(args, 'GET', '/api/v1/workers')
        elif args.action == 'history':
            result = worker_request(args, 'GET', '/api/v1/executions')
        elif args.action in ('get','enable','disable','delete','register','configure','run'):
            if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._:-]{0,127}', args.worker_id) or '..' in args.worker_id:
                raise ValueError('Invalid worker ID')
            path = '/api/v1/workers/' + quote(args.worker_id, safe='')
            if args.action == 'get':
                result = worker_request(args, 'GET', path)
            elif args.action in ('enable','disable'):
                result = worker_request(args, 'POST', path + '/' + args.action, {})
            elif args.action == 'delete':
                if args.confirm_worker != args.worker_id:
                    raise ValueError('--confirm-worker must exactly match worker ID')
                result = worker_request(args, 'DELETE', path)
            elif args.action in ('register','configure'):
                body = {}
                if args.configuration is not None:
                    body['configuration'] = args.configuration
                if args.schedule is not None:
                    if args.schedule == 'interval' and (args.interval is None or args.interval <= 0):
                        raise ValueError('interval schedule requires a positive --interval')
                    if args.schedule == 'manual' and args.interval is not None:
                        raise ValueError('manual schedule does not accept --interval')
                    body['schedule'] = {'kind':args.schedule, 'interval_seconds':args.interval}
                elif args.interval is not None:
                    raise ValueError('--interval requires --schedule interval')
                if args.action == 'register':
                    body.update(worker_id=args.worker_id, artifact_id=args.artifact_id,
                                artifact_hash=args.artifact_hash, entrypoint=args.entrypoint)
                    result = worker_request(args, 'POST', '/api/v1/workers', body)
                else:
                    if not body:
                        raise ValueError('At least one configuration or schedule is required')
                    result = worker_request(args, 'PATCH', path, body)
            else:
                if not math.isfinite(args.timeout) or not 0 < args.timeout <= 300:
                    raise ValueError('Timeout must be greater than 0 and at most 300')
                key = args.idempotency_key or str(uuid4())
                if not key.strip() or len(key) > 256:
                    raise ValueError('Invalid idempotency key')
                print('Idempotency key: ' + key, file=sys.stderr)
                result = worker_request(args, 'POST', path + '/executions',
                    {'input_payload':args.input, 'timeout_seconds':args.timeout, 'idempotency_key':key})
        else:
            path = '/api/v1/executions/' + str(args.execution_id)
            result = worker_request(args, 'POST', path + '/cancel', {}) if args.action == 'cancel' else worker_request(args, 'GET', path)
        print(json.dumps(result, ensure_ascii=False, allow_nan=False))
        return 0
    except (ValueError, TypeError, KeyError, LookupError, UnknownModule, OSError, sqlite3.Error) as error:
        print('30na: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
