[Unit]
Description=30nA owner-scoped Worker Manager
After=network.target
[Service]
Type=simple
User=30na
Group=30na
WorkingDirectory=/opt/30na/current
Environment=PYTHONPATH=/opt/30na/current/units/worker-manager
EnvironmentFile=/etc/30na/worker-manager.env
ExecStart=/opt/30na/current/.venv/bin/python -m uvicorn worker_manager.production:create_app --factory --workers 1 --host 127.0.0.1 --port 8101 --no-access-log --no-proxy-headers --limit-concurrency 64 --timeout-keep-alive 5
Restart=on-failure
RestartSec=3
TimeoutStopSec=360
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/30na/manager
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
[Install]
WantedBy=multi-user.target
