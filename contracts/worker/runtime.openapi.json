            "default": 0,
            "maximum": 0.0,
            "minimum": 0.0,
            "title": "Depth",
            "type": "integer"
          },
          "execution_id": {
            "title": "Execution Id",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "input_payload": {
            "additionalProperties": true,
            "title": "Input Payload",
            "type": "object"
          },
          "timeout_seconds": {
            "default": 30,
            "exclusiveMinimum": 0.0,
            "maximum": 300.0,
            "title": "Timeout Seconds",
            "type": "number"
          }
        },
        "required": [
          "definition",
          "execution_id",
          "idempotency_key"
        ],
        "title": "ExecutionBody",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
