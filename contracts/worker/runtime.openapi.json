          "artifact_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Artifact Id",
            "type": "string"
          },
          "entrypoint": {
            "maxLength": 256,
            "minLength": 3,
            "title": "Entrypoint",
            "type": "string"
          },
